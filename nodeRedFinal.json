    {
        "id": "3ddf5ce6a2418f6f",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "function 1",
        "func": "// Define o limite de velocidade da via\nconst limiteVelocidade = 90;\n\n// Obtém o valor da velocidade vindo do payload (ex: 10, 90 ou 150)\nconst velocidade = Number(msg.payload);\n\nif (velocidade > limiteVelocidade) {\n    msg.statusVelocidade = \"Acima do limite\";\n    msg.payload = `Atenção: ${velocidade} km/h está ACIMA da velocidade limite de ${limiteVelocidade} km/h!`;\n} else if (velocidade === limiteVelocidade) {\n    msg.statusVelocidade = \"No limite\";\n    msg.payload = `Atenção: ${velocidade} km/h está exatamente NO LIMITE da velocidade permitida.`;\n} else {\n    msg.statusVelocidade = \"Abaixo do limite\";\n    msg.payload = `Velocidade OK: ${velocidade} km/h está ABAIXO da velocidade limite de ${limiteVelocidade} km/h.`;\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
